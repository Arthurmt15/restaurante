# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND (.env no diretório backend/)
# ═══════════════════════════════════════════════════════════════════════════════
PORT=3001
JWT_SECRET= Troque esta chave em produção! Use: openssl rand -base64 32
DATABASE_URL=mongodb://localhost:27017/restaurante?authSource=admin&replicaSet=rs0
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
ADMIN_MASTER_EMAIL=seu-email-admin@gmail.com

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND (.env no diretório frontend/ ou na raiz)
# ═══════════════════════════════════════════════════════════════════════════════
# URL pública do backend (usada por Next.js rewrites e API routes server-side)
# Em desenvolvimento: http://localhost:3001
# Em produção (Vercel): https://seu-backend.up.railway.app
API_URL=http://localhost:3001

# URL da API exposta ao cliente (NEXT_PUBLIC = embutida no bundle JS)
# Em desenvolvimento: http://localhost:3001/api
# Em produção (Vercel): https://seu-backend.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH (obtido em https://console.cloud.google.com)
# ═══════════════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=seu-google-client-id-aqui
GOOGLE_CLIENT_SECRET=seu-google-client-secret-aqui

# ═══════════════════════════════════════════════════════════════════════════════
# NEXTAUTH.JS
# ═══════════════════════════════════════════════════════════════════════════════
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET= gere-com-openssl-rand-base64-32

# URL deste frontend (usado pelo NextAuth para callbacks)
# Em desenvolvimento: http://localhost:3000
# Em produção (Vercel): https://seu-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
