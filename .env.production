# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
# Estas são as variáveis de fallback. Em produção, configure via dashboard:
#
# BACKEND (Railway/Render/etc):
#   - PORT=3001
#   - NODE_ENV=production
#   - JWT_SECRET=<gerado com openssl rand -base64 32>
#   - DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/restaurante?authSource=admin
#   - FRONTEND_URL=https://seu-app.vercel.app
#
# FRONTEND (Vercel dashboard → Settings → Environment Variables):
#   - API_URL=https://seu-backend.up.railway.app    (URL pública do backend)
#   - NEXT_PUBLIC_API_URL=https://seu-backend.up.railway.app/api
#   - NEXTAUTH_URL=https://seu-app.vercel.app
#   - NEXTAUTH_SECRET=<gerado com openssl rand -base64 32>
#   - GOOGLE_CLIENT_ID=<do Google Cloud Console>
#   - GOOGLE_CLIENT_SECRET=<do Google Cloud Console>
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_base64_32
DATABASE_URL=mongodb://mongodb:27017/restaurante?authSource=admin
FRONTEND_URL=https://seu-app.vercel.app
NEXT_PUBLIC_API_URL=/api
